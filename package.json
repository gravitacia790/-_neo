{
  "name": "gravitacia-neo",
  "version": "2.0.0",
  "description": "Гравитация — профессиональное сообщество директоров школ Московской области",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:migrate": "node server/migrate.js up",
    "db:migrate:down": "node server/migrate.js down",
    "db:migrate:status": "node server/migrate.js status",
    "check:buttons-db": "node scripts/check-button-db-coverage.js",
    "test:e2e": "playwright test",
    "test": "vitest run test",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .github e2e package.json playwright.config.js vitest.config.js",
    "format:check": "prettier --check .github e2e package.json playwright.config.js vitest.config.js"
  },
  "keywords": [
    "education",
    "community",
    "directors",
    "moscow-region"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0 <23"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pg": "^8.16.3",
    "pg-mem": "^3.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
