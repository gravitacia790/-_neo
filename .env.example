PORT=3000
# Min 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
ADMIN_EMAIL=admin@gravitacia.ru
ADMIN_PASSWORD=change-me-too
# CORS is used only when NODE_ENV is not production (same-origin in prod).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Behind reverse proxy (nginx/Caddy). Usually 1 in production.
TRUST_PROXY=1
# Optional: COOKIE_DOMAIN=.example.ru
#
# PostgreSQL connection string (required outside tests)
# Example local:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/gravitacia
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Per authenticated user; anonymous traffic is limited per IP.
API_RATE_LIMIT_MAX=600
WS_MAX_CONNECTIONS=2000
#
# Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# SMTP для отправки кодов восстановления пароля.
# Если SMTP_HOST не задан — письма не отправляются (в dev код возвращается в ответе API).
# Пример для Яндекс 360: host smtp.yandex.ru, порт 465 (SSL), логин — полный email.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=robot@gravitacia.ru
# SMTP_PASS=app-password
# MAIL_FROM=Гравитация <robot@gravitacia.ru>
#
# Интеграция с мессенджером MAX (привязка аккаунта + коды/уведомления).
# Бот создаётся через @MasterBot в MAX; токен — в заголовке Authorization.
# Без MAX_BOT_TOKEN интеграция выключена (блок привязки в профиле скрыт).
# MAX_BOT_TOKEN=
# MAX_BOT_NAME=GravitaciaBot
# MAX_API_BASE=https://platform-api.max.ru
# Секрет для проверки webhook: задайте URL подписки как
#   https://<домен>/api/integrations/max/webhook?secret=<MAX_WEBHOOK_SECRET>
# и подпишитесь на update_types=["bot_started"] через POST /subscriptions.
# MAX_WEBHOOK_SECRET=
#
# AI-поиск коллег по смыслу профилей.
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_ANSWER_MODEL=gpt-5.4-mini
# AI_MIN_SCORE=0.18
# AI_CANDIDATE_LIMIT=12
# AI_RESULT_LIMIT=5
