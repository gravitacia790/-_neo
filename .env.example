PORT=3000
# Min 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
ADMIN_EMAIL=admin@gravitacia.ru
ADMIN_PASSWORD=change-me-too
# CORS is used only when NODE_ENV is not production (same-origin in prod).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Behind reverse proxy (nginx/Caddy). Usually 1 in production.
TRUST_PROXY=1
# Optional: COOKIE_DOMAIN=.example.ru
#
# PostgreSQL connection string (required outside tests)
# Example local:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/gravitacia
#
# Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
